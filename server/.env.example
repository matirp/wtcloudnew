# ── Server ────────────────────────────────────────────────────────────────
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────
# Local MongoDB (development)
MONGO_URI=mongodb://127.0.0.1:27017/mess

# Amazon DocumentDB (production on EC2)
# Uncomment and fill these when deploying to AWS
# MONGO_URI=mongodb://messadmin:MessPass123!@mess-mgmt-db.cluster-xxxxxxxxxx.ap-south-1.docdb.amazonaws.com:27017/mess
# USE_DOCDB=true

# ── JWT (unused — kept for reference) ─────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES=7d

# ── Seed admin ────────────────────────────────────────────────────────────
ADMIN_NAME=Mess Admin
ADMIN_EMAIL=admin@mess.local
ADMIN_PASSWORD=admin123
